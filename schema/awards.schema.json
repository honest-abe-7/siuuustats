{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siuuustats.pages.dev/schema/awards.schema.json",
  "title": "Award",
  "description": "Individual awards and placings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "award_id",
    "name",
    "awarding_body",
    "year_or_season",
    "placing",
    "source_ids",
    "notes"
  ],
  "properties": {
    "award_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "awarding_body": {
      "type": "string",
      "minLength": 1
    },
    "year_or_season": {
      "type": "string",
      "pattern": "^[0-9]{4}(-[0-9]{2})?$"
    },
    "placing": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 3
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Semicolon-separated source_id list in CSV; each must exist in sources.csv"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
