{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siuuustats.pages.dev/schema/goals.schema.json",
  "title": "Goal",
  "description": "One row per official senior goal scored by Ronaldo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal_id",
    "match_id",
    "team_id",
    "minute",
    "added_time",
    "method",
    "body_part",
    "location",
    "assist_player",
    "assist_type",
    "score_after",
    "intl_goal_no",
    "source_ids",
    "verified_by",
    "verified_at"
  ],
  "properties": {
    "goal_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+-g[0-9]+$",
      "description": "{match_id}-g{n}, n = order within the match"
    },
    "match_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "minute": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 130
    },
    "added_time": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 30
    },
    "method": {
      "type": "string",
      "enum": [
        "open_play",
        "penalty",
        "direct_free_kick",
        "non_penalty_unspecified"
      ]
    },
    "body_part": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "right_foot",
        "left_foot",
        "head",
        "other",
        null
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "inside_box",
        "outside_box",
        null
      ]
    },
    "assist_player": {
      "type": [
        "string",
        "null"
      ]
    },
    "assist_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "opta",
        "deflection",
        "rebound",
        "penalty_won",
        "own_goal_forced",
        "none",
        "source_unspecified",
        null
      ]
    },
    "score_after": {
      "type": "string",
      "pattern": "^[0-9]+-[0-9]+$",
      "description": "Score immediately after the goal, Ronaldo's team first"
    },
    "intl_goal_no": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Number in Wikipedia's international goals list"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Semicolon-separated source_id list in CSV; each must exist in sources.csv"
    },
    "verified_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    }
  }
}
